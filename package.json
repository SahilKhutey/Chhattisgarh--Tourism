{
  "name": "cg-tourism-platform",
  "private": true,
  "packageManager": "pnpm@9.14.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "repo:check": "node scripts/repository/check-repository.mjs",
    "config:check": "node scripts/repository/check-config.mjs",
    "test:config": "pnpm --filter backend test -- config",
    "db:verify": "pnpm --filter backend exec ts-node ../../scripts/db/verify.ts",
    "db:seed": "pnpm --filter backend prisma db seed",
    "prepare": "husky",
    "typecheck": "turbo typecheck",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "pnpm --filter web exec playwright test",
    "ci": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "mobile:typecheck": "pnpm --filter @cg-tourism/mobile typecheck",
    "mobile:test": "pnpm --filter @cg-tourism/mobile test",
    "mobile:sync": "pnpm --filter @cg-tourism/mobile cap:sync",
    "mobile:android": "pnpm --filter @cg-tourism/mobile android",
    "mobile:ios": "pnpm --filter @cg-tourism/mobile ios"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": "20.x",
    "pnpm": "9.14.0"
  }
}
