# ─────────────────────────────────────────────────────────────────────────────
# CG TOURISM PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION SAMPLE
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Copy this file to .env.production on your deployment server.
# NEVER commit actual secrets to version control.

# ── 1. Application Runtime ──────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
FRONTEND_PORT=3000
LOG_LEVEL=info

# ── 2. Database (PostgreSQL 16 + PostGIS) ───────────────────────────────────
# Format: postgresql://[user]:[password]@[host]:[port]/[db_name]?schema=public&sslmode=prefer
DATABASE_URL=postgresql://cgtourism_prod:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/cgtourism?schema=public
POSTGRES_USER=cgtourism_prod
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
POSTGRES_DB=cgtourism

# ── 3. Redis Cache & Queue Broker ───────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── 4. Authentication & Security (JWT) ──────────────────────────────────────
# CRITICAL: Must be at least 32 cryptographically random characters.
# Generate via: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_MINIMUM_32_CHAR_CRYPTOGRAPHIC_SECRET_KEY
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── 5. CORS & Web Security ──────────────────────────────────────────────────
# Comma-separated list of allowed production origins (no wildcards in production)
CORS_ORIGINS=https://cgtourism.gov.in,https://app.cgtourism.gov.in

# ── 6. Frontend Public Endpoints ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.cgtourism.gov.in/api/v1

# ── 7. Storage / S3 / Media CDN (Optional) ──────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=cgtourism-prod-media

# ── 8. External Integrations & APIs (Optional) ──────────────────────────────
GEMINI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
MAPBOX_API_KEY=
OPENWEATHER_API_KEY=
YOUTUBE_API_KEY=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# ── 9. Monetization & Platform Fees ─────────────────────────────────────────
BOOKING_PLATFORM_FEE_BPS=500
BOOKING_CURRENCY=INR
