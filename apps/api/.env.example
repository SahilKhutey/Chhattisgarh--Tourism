# CG Tourism API - Environment Variables
# Application
APP_NAME=CG Tourism API
ENVIRONMENT=development
DEBUG=true
PORT=8000
API_PREFIX=/api
FRONTEND_URL=http://localhost:3000
SECRET_KEY=dev-secret-change-in-production-cg-tourism-2026

# Database (PostgreSQL 16 with PostGIS)
DATABASE_URL=postgresql://cg_tourism:cg_tourism_dev@localhost:5432/cg_tourism

# Redis Cache & PubSub
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# Search & AI Embedding
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_SEARCH_ENABLED=true
INDEX_WORKER_CONCURRENCY=4

# Logging & Monitoring
LOG_LEVEL=INFO
ENABLE_ACCESS_LOG=true
