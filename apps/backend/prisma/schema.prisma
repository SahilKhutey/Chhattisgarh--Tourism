generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER & AUTH MODELS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String          @id @default(uuid())
  fullName      String
  email         String          @unique
  password      String
  avatar        String?
  role          String          @default("USER")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  bookmarks      Bookmark[]
  reviews        Review[]
  folklore       Folklore[]
  bookings       Booking[]
  creatorProfile CreatorProfile?
  refreshTokens  RefreshToken[]
  videoComments  VideoComment[]
  savedTrips     SavedTrip[]
  pollVotes      PollVote[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTENT MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Folklore {
  id            String   @id @default(uuid())
  title         String
  monument      String
  location      String
  description   String
  images        String   @default("[]")
  videos        String   @default("[]")
  audioUrl      String?
  audioNarrator String?
  verified      Boolean  @default(false)
  authorId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author        User     @relation(fields: [authorId], references: [id])
}

model Place {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String
  district      String
  categoryId    String

  latitude      Float
  longitude     Float

  heroImage     String
  bestSeason    String?

  history       String?
  safetyInfo    String?
  rules         String?
  audioUrl      String?
  audioNarrator String?

  verified          Boolean  @default(false)
  verificationLevel String   @default("UNVERIFIED") // UNVERIFIED, AI_ESTIMATED, COMMUNITY, CREATOR_VERIFIED, OFFICIAL

  highlights       String   @default("[]") // JSON array of strings
  experienceTypes  String   @default("[]") // JSON array of strings
  platformFeatures String   @default("[]") // JSON array of strings
  recommendedMedia String   @default("[]") // JSON array of strings
  priorityPhase    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category        Category        @relation(fields: [categoryId], references: [id])
  media           Media[]
  metadata        PlaceMetadata?
  weather         PlaceWeather?
  transport       PlaceTransport?
  reviews         Review[]
  bookmarks       Bookmark[]
  bookings        Booking[]

  scores          DestinationScore?
  events          TourismEvent[]
  systemFlags     SystemFlag[]
}

model Category {
  id     String  @id @default(uuid())
  name   String
  slug   String  @unique

  places Place[]
}

model Media {
  id               String   @id @default(uuid())
  url              String
  type             String   @default("IMAGE") // IMAGE, VIDEO, REEL, 360, MAP, AUDIO
  
  title            String?
  description      String?
  photographer     String?
  creatorHandle    String?
  camera           String?
  orientation      String   @default("landscape")
  season           String?
  
  tags             String   @default("[]") // JSON
  dominantColors   String   @default("[]") // JSON
  aiLabels         String   @default("[]") // JSON
  aiSceneType      String?
  aiWeather        String?
  aiMood           String?
  aiTimeOfDay      String?
  aiCrowdDensity   String?
  
  location         String?  // JSON
  license          String   @default("PLATFORM_LICENSED") // PLATFORM_LICENSED, CREATOR_LICENSED, CC, GOVT_PUBLIC
  status           String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  
  placeId          String
  place            Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  
  uploadedAt       DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  systemFlags      SystemFlag[]
}

model PlaceMetadata {
  id              String  @id @default(uuid())
  placeId         String  @unique
  metaTitle       String?
  metaDescription String?
  keywords        String  @default("[]") // JSON array
  schemaOrg       String? // JSON object string
  openGraph       String? // JSON object string
  
  howToReach      String? // JSON or text
  weatherPatterns String  @default("[]") // JSON array
  
  place           Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model PlaceWeather {
  id              String   @id @default(uuid())
  placeId         String   @unique
  currentTemp     Float?
  condition       String?  // e.g., "Rainy", "Sunny"
  humidity        Int?
  windSpeed       Float?
  alerts          String   @default("[]") // JSON array of active alerts
  monsoonWarning  Boolean  @default(false)
  lastFetchedAt   DateTime @default(now())

  place           Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model PlaceTransport {
  id              String   @id @default(uuid())
  placeId         String   @unique
  nearestAirport  String?
  airportDistance Float?
  nearestStation  String?
  stationDistance Float?
  busAvailability String?
  roadCondition   String?
  dynamicRoutes   String   @default("[]") // JSON routing data from Mapbox/Google

  place           Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  rating    Int      // 1–5 stars
  comment   String
  lang      String   @default("en") // Language the review was written in
  helpful   Int      @default(0)    // Helpful votes

  userId    String
  placeId   String

  user      User     @relation(fields: [userId], references: [id])
  place     Place    @relation(fields: [placeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placeId])
  @@index([userId])
}

model Bookmark {
  id      String @id @default(uuid())

  userId  String
  placeId String

  user    User  @relation(fields: [userId], references: [id])
  place   Place @relation(fields: [placeId], references: [id])

  @@unique([userId, placeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// BOOKING SYSTEM
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id          String   @id @default(uuid())
  userId      String
  placeId     String
  visitDate   DateTime
  guests      Int      @default(1)
  totalPrice  Float    @default(0)
  status      String   @default("CONFIRMED")  // CONFIRMED | CANCELLED | COMPLETED
  notes       String?
  contactPhone String?

  user        User     @relation(fields: [userId], references: [id])
  place       Place    @relation(fields: [placeId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([placeId])
  @@index([visitDate])
}


model CreatorProfile {
  id       String  @id @default(uuid())
  userId   String  @unique

  verified  Boolean @default(false)
  bio       String?
  instagram String?
  youtube   String?

  // Added from frontend mocks
  district           String   @default("Unknown")
  followers          String   @default("0")
  contentCount       Int      @default(0)
  engagementScore    Int      @default(0)
  tourismScore       Int      @default(0)
  ecoSafeScore       Int      @default(0)
  categories         String   @default("[]") // JSON string array
  languages          String   @default("[]") // JSON string array
  verificationBadges String   @default("[]") // JSON string array

  user      User           @relation(fields: [userId], references: [id])
  videos    CreatorVideo[]
  integrations SocialIntegration[]
  aggregatedContent AggregatedContent[]
}

model CreatorVideo {
  id           String  @id @default(uuid())
  title        String
  location     String
  district     String
  category     String
  language     String
  views        String  @default("0")
  duration     String  @default("0:00")
  thumbnailUrl String
  videoUrl     String?
  isTrending   Boolean @default(false)
  isHiddenGem  Boolean @default(false)

  creatorId    String
  creator      CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  comments       VideoComment[]
  savedTrips     SavedTrip[]
  polls          Poll[]
}

// ─────────────────────────────────────────────────────────────────────────────
// EMERGENCY & SAFETY MODELS
// ─────────────────────────────────────────────────────────────────────────────

model EmergencyAlert {
  id               String    @id @default(uuid())
  alertId          String    @unique
  touristName      String
  touristPhone     String?
  medicalNotes     String?
  latitude         Float
  longitude        Float
  status           String    @default("DISPATCHED")
  primaryResponder String
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?
}

model Translation {
  id         String   @id @default(uuid())
  lang       String   // "en", "hi", "cg", "gondi", "halbi"
  entityType String   // "Place", "Category", "Folklore"
  entityId   String
  field      String   // "name", "description", "tagline", "story"
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([lang, entityType, entityId, field])
}

// ─────────────────────────────────────────────────────────────────────────────
// LIVE TRANSLATION CACHE (Google Cloud Translate API results)
// ─────────────────────────────────────────────────────────────────────────────

model TranslationCache {
  id          String   @id @default(uuid())
  sourceText  String
  sourceLang  String   @default("en")
  targetLang  String
  translated  String
  apiProvider String   @default("google")
  createdAt   DateTime @default(now())

  @@unique([sourceText, sourceLang, targetLang])
  @@index([targetLang])
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY & PLAN TRIP MODELS (Creators Page)
// ─────────────────────────────────────────────────────────────────────────────

model VideoComment {
  id        String   @id @default(uuid())
  text      String
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user      User         @relation(fields: [userId], references: [id])
  video     CreatorVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model SavedTrip {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user      User         @relation(fields: [userId], references: [id])
  video     CreatorVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Poll {
  id        String   @id @default(uuid())
  question  String
  videoId   String
  createdAt DateTime @default(now())

  video     CreatorVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id        String @id @default(uuid())
  text      String
  pollId    String

  poll      Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
}

model PollVote {
  id        String @id @default(uuid())
  userId    String
  pollId    String
  optionId  String

  user      User       @relation(fields: [userId], references: [id])
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  
  @@unique([userId, pollId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CREATOR AGGREGATION SYSTEM (PHASE 1)
// ─────────────────────────────────────────────────────────────────────────────

model SocialIntegration {
  id              String   @id @default(uuid())
  creatorId       String
  platform        String   // "INSTAGRAM", "YOUTUBE", "FACEBOOK", "TWITTER"
  platformUserId  String?
  accessToken     String?
  refreshToken    String?
  tokenExpiresAt  DateTime?
  
  // Sync Preferences
  syncEnabled     Boolean  @default(true)
  syncTravelOnly  Boolean  @default(true)
  autoApprove     Boolean  @default(false)
  autoGenerateTags Boolean @default(true)
  
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator         CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, platform])
}

model AggregatedContent {
  id              String   @id @default(uuid())
  socialId        String   // Unique ID from the platform (e.g. IG Media ID)
  platform        String   // "INSTAGRAM", "YOUTUBE"
  creatorId       String
  
  rawMetadata     String   // JSON payload from platform
  mediaUrl        String
  thumbnailUrl    String
  caption         String?
  
  creator         CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  
  // AI Processed Data
  detectedLocation String?
  detectedCategory String?
  suggestedTags    String   @default("[]") // JSON array
  isTravelRelated  Boolean  @default(true)
  
  status          String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  
  publishedVideoId String? // Links to CreatorVideo if published

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([platform, socialId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ATIS (AUTONOMOUS TOURISM INTELLIGENCE SYSTEM) MODELS
// ─────────────────────────────────────────────────────────────────────────────

model DestinationScore {
  id              String   @id @default(uuid())
  placeId         String   @unique
  popularity      Int      @default(50) // 0-100
  safety          Int      @default(50) // 0-100
  accessibility   Int      @default(50) // 0-100
  mediaQuality    Int      @default(50) // 0-100
  ecoSensitivity  Int      @default(50) // 0-100
  lastUpdated     DateTime @default(now())

  place           Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model TourismEvent {
  id              String   @id @default(uuid())
  placeId         String
  name            String
  description     String?
  startDate       DateTime
  endDate         DateTime
  estimatedCrowd  Int?
  eventType       String   @default("FESTIVAL") // FESTIVAL, MELA, SEASONAL_SPIKE

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  place           Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model SystemFlag {
  id              String   @id @default(uuid())
  placeId         String?
  mediaId         String?
  flagType        String   // OUTDATED_IMAGE, BROKEN_ROAD, SEASONAL_CLOSURE, CROWD_SURGE, COPYRIGHT_STRIKE, NSFW
  description     String?
  status          String   @default("OPEN") // OPEN, RESOLVED, IGNORED
  aiConfidence    Float?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  place           Place?   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  media           Media?   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}
