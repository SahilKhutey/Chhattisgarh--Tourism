generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER & AUTH MODELS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String
  avatar    String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookmarks                Bookmark[]
  reviews                  Review[]
  folklore                 Folklore[]
  bookings                 Booking[]
  creatorProfile           CreatorProfile?
  refreshTokens            RefreshToken[]
  videoComments            VideoComment[]
  savedTrips               SavedTrip[]
  pollVotes                PollVote[]
  ownedPlaces              Place[]             @relation("PlaceContentOwner")
  placeVerificationActions PlaceVerification[] @relation("PlaceVerificationReviewer")
  followingCreators        CreatorFollow[]     @relation("UserCreatorFollows")
  contentReports           ContentReport[]     @relation("UserContentReports")
  mobileDevices            MobileDevice[]
  createdContentTemplates  ContentTemplate[]   @relation("ContentTemplateCreatedBy")
  updatedContentTemplates  ContentTemplate[]   @relation("ContentTemplateUpdatedBy")
  createdTemplateVersions  TemplateVersion[]   @relation("TemplateVersionCreatedBy")
  contentEntries           ContentEntry[]      @relation("ContentEntryAuthor")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTENT MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Folklore {
  id            String   @id @default(uuid())
  title         String
  monument      String
  location      String
  description   String
  images        String   @default("[]")
  videos        String   @default("[]")
  audioUrl      String?
  audioNarrator String?
  verified      Boolean  @default(false)
  status        String   @default("PENDING")
  authorId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])
}

model Place {
  id          String @id @default(uuid())
  name        String
  slug        String @unique
  description String

  // @deprecated: Legacy compatibility. Authoritative relation is via GeoPlace -> TouristZone -> District -> Division.
  district   String
  categoryId String

  latitude  Float
  longitude Float

  heroImage  String
  bestSeason String?

  history       String?
  safetyInfo    String?
  rules         String?
  audioUrl      String?
  audioNarrator String?

  // ─────────────────────────────────────────────
  // CONTENT GOVERNANCE
  // ─────────────────────────────────────────────

  verified          Boolean   @default(false)
  verificationLevel String    @default("UNVERIFIED") // UNVERIFIED, AI_ESTIMATED, COMMUNITY, CREATOR_VERIFIED, OFFICIAL
  contentStatus     String    @default("DRAFT") // DRAFT, PENDING_REVIEW, APPROVED, REJECTED, ARCHIVED
  sourceType        String    @default("INTERNAL") // INTERNAL, CREATOR, COMMUNITY, GOVERNMENT, PARTNER, IMPORTED
  sourceName        String?
  sourceUrl         String?
  contentOwnerId    String?
  verificationNotes String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // ─────────────────────────────────────────────
  // EXISTING CONTENT
  // ─────────────────────────────────────────────

  // @deprecated: Structured search/filtering attributes should reside in ContentEntry.
  highlights       String  @default("[]")
  experienceTypes  String  @default("[]")
  platformFeatures String  @default("[]")
  recommendedMedia String  @default("[]")
  priorityPhase    String?

  bookingEnabled    Boolean @default(true)
  bookingPricePaise Int     @default(0)
  bookingMaxGuests  Int     @default(20)

  // ─────────────────────────────────────────────
  // RELATIONS
  // ─────────────────────────────────────────────

  category            Category              @relation(fields: [categoryId], references: [id])
  contentOwner        User?                 @relation("PlaceContentOwner", fields: [contentOwnerId], references: [id], onDelete: SetNull)
  media               Media[]
  metadata            PlaceMetadata?
  weather             PlaceWeather?
  transport           PlaceTransport?
  reviews             Review[]
  bookmarks           Bookmark[]
  bookings            Booking[]
  scores              DestinationScore?
  planningProfile     PlacePlanningProfile?
  events              TourismEvent[]
  systemFlags         SystemFlag[]
  verificationHistory PlaceVerification[]

  // ─────────────────────────────────────────────
  // GEOSPATIAL HIERARCHY (PHASE P7)
  // ─────────────────────────────────────────────
  districtRelId       String?
  districtRel         District?    @relation(fields: [districtRelId], references: [id], onDelete: SetNull)
  touristZoneId       String?
  touristZone         TouristZone?          @relation(fields: [touristZoneId], references: [id], onDelete: SetNull)
  coordinateValidated Boolean               @default(false)
  boundaryValidated   Boolean               @default(false)

  shortDescription    String?
  altitudeMeters      Decimal?              @db.Decimal(10, 2)
  status              PlaceStatus           @default(DRAFT)
  visibility          Visibility            @default(PRIVATE)
  publishedAt         DateTime?
  location            Unsupported("geography(Point, 4326)")?

  placeCategories     PlaceCategory[]
  placeMedia          PlaceMedia[]
  experiences         Experience[]
  services            TourismService[]
  safety              SafetyProfile?
  routePlaces         RoutePlace[]          @relation("RoutePlacePlace")
  itineraryStops      ItineraryStop[]
  creatorContents     CreatorContent[]

  @@index([status])
  @@index([visibility])
  @@index([contentStatus])
  @@index([verificationLevel])
  @@index([contentOwnerId])
  @@index([verified])
  @@index([district])
  @@index([categoryId])
  @@index([districtRelId])
  @@index([touristZoneId])
}

model PlaceVerification {
  id         String   @id @default(uuid())
  placeId    String
  reviewerId String
  fromLevel  String
  toLevel    String
  decision   String // SUBMITTED, APPROVED, REJECTED, REVOKED, UPDATED
  notes      String?
  createdAt  DateTime @default(now())

  place    Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  reviewer User  @relation("PlaceVerificationReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([placeId])
  @@index([reviewerId])
  @@index([decision])
  @@index([createdAt])
}

model Category {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  description String?
  icon        String?
  isActive    Boolean         @default(true)

  places          Place[]
  placeCategories PlaceCategory[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
}

model Media {
  id String @id @default(uuid())

  url  String
  type String @default("IMAGE")

  title         String?
  description   String?
  photographer  String?
  creatorHandle String?

  camera      String?
  orientation String  @default("landscape")
  season      String?

  tags           String  @default("[]")
  dominantColors String  @default("[]")
  aiLabels       String  @default("[]")
  aiSceneType    String?
  aiWeather      String?
  aiMood         String?
  aiTimeOfDay    String?
  aiCrowdDensity String?

  location String?
  license  String  @default("PLATFORM_LICENSED")
  status   String  @default("PENDING")

  // ─────────────────────────────────────────────
  // ASSET STORAGE
  // ─────────────────────────────────────────────

  objectKey String?
  mimeType  String?
  fileSize  Int?

  width  Int?
  height Int?

  checksumSha256 String?

  sourceUrl  String?
  sourceName String?

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  systemFlags SystemFlag[]

  @@index([placeId])
  @@index([type])
  @@index([status])
  @@index([checksumSha256])
}

model PlaceMetadata {
  id              String  @id @default(uuid())
  placeId         String  @unique
  metaTitle       String?
  metaDescription String?
  keywords        String  @default("[]") // JSON array
  schemaOrg       String? // JSON object string
  openGraph       String? // JSON object string

  howToReach      String? // JSON or text
  weatherPatterns String  @default("[]") // JSON array

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model PlaceWeather {
  id             String   @id @default(uuid())
  placeId        String   @unique
  currentTemp    Float?
  condition      String? // e.g., "Rainy", "Sunny"
  humidity       Int?
  windSpeed      Float?
  alerts         String   @default("[]") // JSON array of active alerts
  monsoonWarning Boolean  @default(false)
  lastFetchedAt  DateTime @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model PlaceTransport {
  id              String  @id @default(uuid())
  placeId         String  @unique
  nearestAirport  String?
  airportDistance Float?
  nearestStation  String?
  stationDistance Float?
  busAvailability String?
  roadCondition   String?
  dynamicRoutes   String  @default("[]") // JSON routing data from Mapbox/Google

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model Review {
  id      String @id @default(uuid())
  rating  Int
  comment String

  lang    String @default("en")
  helpful Int    @default(0)

  userId  String
  placeId String

  bookingId String? @unique

  verifiedVisit Boolean      @default(false)
  reviewStatus  ReviewStatus @default(PUBLISHED)

  user  User  @relation(fields: [userId], references: [id])
  place Place @relation(fields: [placeId], references: [id])

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placeId])
  @@index([userId])
}

model Bookmark {
  id String @id @default(uuid())

  userId  String
  placeId String

  user  User  @relation(fields: [userId], references: [id])
  place Place @relation(fields: [placeId], references: [id])

  @@unique([userId, placeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// BOOKING SYSTEM
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id String @id @default(uuid())

  userId  String
  placeId String?

  productId      String?
  partnerId      String?
  availabilityId String?

  visitDate DateTime?
  guests    Int       @default(1)
  quantity  Int       @default(1)

  unitPricePaise   Int?
  subtotalPaise    Int?
  platformFeePaise Int?
  totalPricePaise  Int?

  unitPrice   Decimal? @db.Decimal(12, 2)
  totalAmount Decimal? @db.Decimal(12, 2)

  currency String @default("INR")

  // Legacy compatibility field.
  totalPrice Float @default(0)

  status        String        @default("CONFIRMED")
  paymentStatus PaymentStatus @default(UNPAID)

  bookingReference String? @unique

  notes        String?
  contactPhone String?

  user    User?           @relation(fields: [userId], references: [id])
  place   Place?          @relation(fields: [placeId], references: [id])
  product TourismProduct? @relation(fields: [productId], references: [id])
  partner Partner?        @relation(fields: [partnerId], references: [id])

  review        Review?
  commission    PartnerCommission?
  productReview ProductReview?
  webhookEvents PaymentWebhookEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([placeId])
  @@index([partnerId])
  @@index([productId])
  @@index([visitDate])
  @@index([status])
}

model CreatorProfile {
  id     String @id @default(uuid())
  userId String @unique

  verified  Boolean @default(false)
  bio       String?
  instagram String?
  youtube   String?

  // Added from frontend mocks
  district           String @default("Unknown")
  followers          String @default("0")
  contentCount       Int    @default(0)
  engagementScore    Int    @default(0)
  tourismScore       Int    @default(0)
  ecoSafeScore       Int    @default(0)
  categories         String @default("[]") // JSON string array
  languages          String @default("[]") // JSON string array
  verificationBadges String @default("[]") // JSON string array

  user              User                @relation(fields: [userId], references: [id])
  creatorStatus     CreatorStatus       @default(PENDING)
  followersCount    Int                 @default(0)
  viewsCount        Int                 @default(0)
  contents          CreatorContent[]
  videos            CreatorVideo[]
  integrations      SocialIntegration[]
  aggregatedContent AggregatedContent[]
  followersRelation CreatorFollow[]     @relation("CreatorFollowers")
}

model CreatorVideo {
  id           String  @id @default(uuid())
  title        String
  location     String
  district     String
  category     String
  language     String
  views        String  @default("0")
  duration     String  @default("0:00")
  thumbnailUrl String
  videoUrl     String?
  isTrending   Boolean @default(false)
  isHiddenGem  Boolean @default(false)
  status       String  @default("PUBLISHED")

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments   VideoComment[]
  savedTrips SavedTrip[]
  polls      Poll[]
}

// ─────────────────────────────────────────────────────────────────────────────
// EMERGENCY & SAFETY MODELS
// ─────────────────────────────────────────────────────────────────────────────

model EmergencyStation {
  id           String           @id @default(uuid())
  name         String           @unique
  phone        String
  type         String
  district     String
  division     String?
  latitude     Float
  longitude    Float
  active       Boolean          @default(true)
  priority     Int              @default(0)
  capabilities String           @default("[]")
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  alerts       EmergencyAlert[] @relation("PrimaryEmergencyStation")

  @@index([district])
  @@index([division])
  @@index([type])
  @@index([active])
  @@index([latitude, longitude])
}

model EmergencyAlert {
  id                 String            @id @default(uuid())
  alertId            String            @unique
  touristName        String
  touristPhone       String?
  medicalNotes       String?
  latitude           Float
  longitude          Float
  status             String            @default("DISPATCHED")
  primaryResponder   String
  primaryResponderId String?
  primaryStation     EmergencyStation? @relation("PrimaryEmergencyStation", fields: [primaryResponderId], references: [id], onDelete: SetNull)
  backupResponders   String            @default("[]")
  dispatchMetadata   String            @default("{}")
  createdAt          DateTime          @default(now())
  resolvedAt         DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([primaryResponderId])
}

model Translation {
  id         String   @id @default(uuid())
  lang       String // "en", "hi", "cg", "gondi", "halbi"
  entityType String // "Place", "Category", "Folklore"
  entityId   String
  field      String // "name", "description", "tagline", "story"
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([lang, entityType, entityId, field])
}

// ─────────────────────────────────────────────────────────────────────────────
// LIVE TRANSLATION CACHE (Google Cloud Translate API results)
// ─────────────────────────────────────────────────────────────────────────────

model TranslationCache {
  id          String   @id @default(uuid())
  sourceText  String
  sourceLang  String   @default("en")
  targetLang  String
  translated  String
  apiProvider String   @default("google")
  createdAt   DateTime @default(now())

  @@unique([sourceText, sourceLang, targetLang])
  @@index([targetLang])
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY & PLAN TRIP MODELS (Creators Page)
// ─────────────────────────────────────────────────────────────────────────────

model VideoComment {
  id        String   @id @default(uuid())
  text      String
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id])
  video CreatorVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model SavedTrip {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id])
  video CreatorVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Poll {
  id        String   @id @default(uuid())
  question  String
  videoId   String
  createdAt DateTime @default(now())

  video   CreatorVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     String @id @default(uuid())
  text   String
  pollId String

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
}

model PollVote {
  id       String @id @default(uuid())
  userId   String
  pollId   String
  optionId String

  user User @relation(fields: [userId], references: [id])
  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([userId, pollId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CREATOR AGGREGATION SYSTEM (PHASE 1)
// ─────────────────────────────────────────────────────────────────────────────

model SocialIntegration {
  id             String    @id @default(uuid())
  creatorId      String
  platform       String // "INSTAGRAM", "YOUTUBE", "FACEBOOK", "TWITTER"
  platformUserId String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?

  // Sync Preferences
  syncEnabled      Boolean @default(true)
  syncTravelOnly   Boolean @default(true)
  autoApprove      Boolean @default(false)
  autoGenerateTags Boolean @default(true)

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, platform])
}

model AggregatedContent {
  id        String @id @default(uuid())
  socialId  String // Unique ID from the platform (e.g. IG Media ID)
  platform  String // "INSTAGRAM", "YOUTUBE"
  creatorId String

  rawMetadata  String // JSON payload from platform
  mediaUrl     String
  thumbnailUrl String
  caption      String?

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // AI Processed Data
  detectedLocation String?
  detectedCategory String?
  suggestedTags    String  @default("[]") // JSON array
  isTravelRelated  Boolean @default(true)

  status String @default("PENDING") // "PENDING", "APPROVED", "REJECTED"

  publishedVideoId String? // Links to CreatorVideo if published

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, socialId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ATIS (AUTONOMOUS TOURISM INTELLIGENCE SYSTEM) MODELS
// ─────────────────────────────────────────────────────────────────────────────

model PlacePlanningProfile {
  id      String @id @default(uuid())
  placeId String @unique

  visitorCapacity       Int?
  estimatedVisitMinutes Int  @default(90)

  planningEnabled Boolean @default(true)

  seasonalAvailability String?
  planningNotes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model DestinationScore {
  id             String   @id @default(uuid())
  placeId        String   @unique
  popularity     Int      @default(50) // 0-100
  safety         Int      @default(50) // 0-100
  accessibility  Int      @default(50) // 0-100
  mediaQuality   Int      @default(50) // 0-100
  ecoSensitivity Int      @default(50) // 0-100
  lastUpdated    DateTime @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model TourismEvent {
  id             String   @id @default(uuid())
  placeId        String
  name           String
  description    String?
  startDate      DateTime
  endDate        DateTime
  estimatedCrowd Int?
  eventType      String   @default("FESTIVAL") // FESTIVAL, MELA, SEASONAL_SPIKE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model SystemFlag {
  id           String  @id @default(uuid())
  placeId      String?
  mediaId      String?
  flagType     String // OUTDATED_IMAGE, BROKEN_ROAD, SEASONAL_CLOSURE, CROWD_SURGE, COPYRIGHT_STRIKE, NSFW
  description  String?
  status       String  @default("OPEN") // OPEN, RESOLVED, IGNORED
  aiConfidence Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  place Place? @relation(fields: [placeId], references: [id], onDelete: Cascade)
  media Media? @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// GEOSPATIAL & REGIONAL ADMINISTRATIVE HIERARCHY (PHASE P7)
// ─────────────────────────────────────────────────────────────────────────────

enum GeoStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Division {
  id     String    @id @default(uuid())
  name   String
  slug   String    @unique
  nameHi String?
  code   String    @unique
  status GeoStatus @default(ACTIVE)

  districts District[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([slug])
}

model District {
  id         String    @id @default(uuid())
  divisionId String
  division   Division  @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  name       String
  slug       String    @unique
  nameHi     String?
  code       String    @unique
  latitude   Decimal?  @db.Decimal(9, 6)
  longitude  Decimal?  @db.Decimal(9, 6)
  status     GeoStatus @default(ACTIVE)

  zones    TouristZone[]
  places   Place[]
  boundary DistrictBoundary?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([divisionId])
  @@index([status])
  @@index([slug])
}

model TouristZone {
  id          String    @id @default(uuid())
  districtId  String
  district    District  @relation(fields: [districtId], references: [id], onDelete: Restrict)
  name        String
  slug        String    @unique
  description String?
  latitude    Decimal?  @db.Decimal(9, 6)
  longitude   Decimal?  @db.Decimal(9, 6)
  status      GeoStatus @default(ACTIVE)

  places    Place[]
  geoPlaces GeoPlace[]
  routes    Route[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
  @@index([status])
  @@index([slug])
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 2 — REGIONAL TOURISM DATA & CONTENT KERNEL
// ─────────────────────────────────────────────────────────────────────────────

enum PlaceStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PRIVATE
  PUBLIC
}

enum Difficulty {
  EASY
  MODERATE
  HARD
  EXPERT
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum ServiceType {
  FOOD
  STAY
  TRANSPORT
  GUIDE
  PARKING
  MEDICAL
  TOILET
  ATM
  INFORMATION
  OTHER
}

model PlaceCategory {
  placeId    String
  categoryId String

  place    Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([placeId, categoryId])
  @@index([categoryId])
}

model Experience {
  id          String     @id @default(cuid())
  placeId     String
  slug        String     @unique
  title       String
  description String?
  durationMin Int?
  difficulty  Difficulty @default(EASY)
  isActive    Boolean    @default(true)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  itineraryStops ItineraryStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placeId])
}

model TourismService {
  id          String      @id @default(cuid())
  placeId     String
  type        ServiceType
  name        String
  description String?
  phone       String?
  website     String?
  isActive    Boolean     @default(true)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placeId])
}

model PlaceMedia {
  id        String    @id @default(cuid())
  placeId   String
  url       String
  type      MediaType
  altText   String?
  caption   String?
  sortOrder Int       @default(0)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([placeId])
}

model SafetyProfile {
  id              String   @id @default(cuid())
  placeId         String   @unique
  emergencyNotes  String?
  accessibility   String?
  seasonalWarning String?
  medicalNotes    String?

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

model Route {
  id          String       @id @default(cuid())
  zoneId      String?
  slug        String       @unique
  name        String
  description String?
  distanceKm  Decimal?     @db.Decimal(10, 2)
  durationMin Int?

  zone   TouristZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  places RoutePlace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
}

model RoutePlace {
  routeId  String
  placeId  String
  sequence Int

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  place Place @relation("RoutePlacePlace", fields: [placeId], references: [id], onDelete: Cascade)

  @@id([routeId, placeId])
  @@unique([routeId, sequence])
}


model DistrictBoundary {
  id            String    @id @default(uuid())
  districtId    String    @unique
  district      District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  source        String
  sourceVersion String?
  validatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
}

model GeoPlace {
  id                  String      @id @default(uuid())
  touristZoneId       String
  touristZone         TouristZone @relation(fields: [touristZoneId], references: [id], onDelete: Restrict)
  externalPlaceId     String?     @unique
  name                String
  slug                String      @unique
  latitude            Decimal     @db.Decimal(9, 6)
  longitude           Decimal     @db.Decimal(9, 6)
  elevationM          Decimal?    @db.Decimal(8, 2)
  status              GeoStatus   @default(ACTIVE)
  coordinateValidated Boolean     @default(false)
  boundaryValidated   Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([touristZoneId])
  @@index([latitude, longitude])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// SOCIAL & COMMUNITY LAYER (PHASE P9)
// ─────────────────────────────────────────────────────────────────────────────

model CreatorFollow {
  id        String   @id @default(uuid())
  userId    String
  creatorId String
  createdAt DateTime @default(now())

  user    User           @relation("UserCreatorFollows", fields: [userId], references: [id], onDelete: Cascade)
  creator CreatorProfile @relation("CreatorFollowers", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId])
  @@index([creatorId])
  @@index([userId])
}

model ContentReport {
  id            String   @id @default(uuid())
  reporterId    String
  targetType    String
  targetId      String
  reason        String
  details       String?
  status        String   @default("OPEN")
  moderatorNote String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reporter User @relation("UserContentReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
}

// ─────────────────────────────────────────────────────────────────────────────
// REGIONAL INTELLIGENCE, TELEMETRY & OPERATIONS (PHASE 17)
// ─────────────────────────────────────────────────────────────────────────────

enum AnalyticsEventType {
  PAGE_VIEW
  SEARCH
  PLACE_VIEW
  DISTRICT_VIEW
  CATEGORY_VIEW
  MAP_VIEW
  ROUTE_REQUEST
  ITINERARY_CREATED
  ITINERARY_COMPLETED
  SAVE_PLACE
  UNSAVE_PLACE
  SHARE_PLACE
  BOOKING_STARTED
  BOOKING_COMPLETED
  REVIEW_CREATED
  CREATOR_VIEW
  FOLKLORE_VIEW
  SOS_TRIGGERED
  LANGUAGE_CHANGED
  OFFLINE_SESSION
}

model AnalyticsEvent {
  id   String             @id @default(uuid())
  type AnalyticsEventType @default(PAGE_VIEW)
  name String?

  userId     String?
  placeId    String?
  districtId String?
  bookingId  String?

  sessionId String?
  latitude  Float?
  longitude Float?
  language  String?
  platform  String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([type])
  @@index([name])
  @@index([createdAt])
  @@index([placeId])
  @@index([districtId])
  @@index([userId])
  @@index([sessionId])
  @@index([bookingId])
}

model TourismMetric {
  id     String @id @default(uuid())
  metric String
  value  Float

  districtId String?
  placeId    String?

  periodStart DateTime
  periodEnd   DateTime

  metadata Json?

  createdAt DateTime @default(now())

  @@index([metric])
  @@index([districtId])
  @@index([placeId])
  @@index([periodStart])
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model SystemAlert {
  id       String        @id @default(uuid())
  type     String
  severity AlertSeverity

  title       String
  description String

  districtId String?
  placeId    String?

  resolved Boolean @default(false)

  metadata Json?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([type])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
}

model RecommendationFeedback {
  id String @id @default(uuid())

  userId  String?
  placeId String

  recommendationSource String

  shownAt          DateTime  @default(now())
  clickedAt        DateTime?
  savedAt          DateTime?
  itineraryAddedAt DateTime?
  completedAt      DateTime?

  rating Float?

  metadata Json?

  @@index([placeId])
  @@index([userId])
  @@index([recommendationSource])
}

// ─────────────────────────────────────────────────────────────────────────────
// MOBILE PLATFORM & PUSH DEVICE REGISTRY
// ─────────────────────────────────────────────────────────────────────────────

model MobileDevice {
  id          String   @id @default(uuid())
  userId      String?
  deviceToken String   @unique
  platform    String
  appVersion  String?
  deviceId    String?
  active      Boolean  @default(true)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
  @@index([active])
}

// ─────────────────────────────────────────────────────────────────────────────
// REGIONAL COMMERCE, PARTNER NETWORK & MARKETPLACE (PHASE 18)
// ─────────────────────────────────────────────────────────────────────────────

enum PartnerStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  SUSPENDED
  REJECTED
}

enum InventoryType {
  HOMESTAY
  GUIDE
  EXPERIENCE
  EVENT
  TRANSPORT
  ACTIVITY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  UNPAID
  AUTHORIZED
  PAID
  REFUND_PENDING
  REFUNDED
  FAILED
}

model Partner {
  id String @id @default(uuid())

  name        String
  slug        String  @unique
  description String?

  phone String?
  email String?

  status PartnerStatus @default(PENDING)

  districtId String?
  latitude   Float?
  longitude  Float?

  logoUrl    String?
  websiteUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products TourismProduct[]
  bookings Booking[]

  @@index([status])
  @@index([districtId])
}

model TourismProduct {
  id String @id @default(uuid())

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  name        String
  slug        String @unique
  description String

  type InventoryType

  price    Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  capacity    Int
  durationMin Int?

  latitude  Float?
  longitude Float?

  active Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availability ProductAvailability[]
  bookings     Booking[]
  reviews      ProductReview[]
  policy       CancellationPolicy?

  @@index([partnerId])
  @@index([type])
  @@index([active])
}

model ProductAvailability {
  id String @id @default(uuid())

  productId String
  product   TourismProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  startAt DateTime
  endAt   DateTime

  capacity Int
  reserved Int @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([startAt])
}

model PartnerCommission {
  id String @id @default(uuid())

  bookingId String @unique
  partnerId String

  grossAmount      Decimal @db.Decimal(12, 2)
  commissionRate   Decimal @db.Decimal(5, 2)
  commissionAmount Decimal @db.Decimal(12, 2)
  partnerAmount    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model ProductReview {
  id String @id @default(uuid())

  productId String
  bookingId String @unique
  userId    String

  rating Int
  title  String?
  body   String?

  verifiedPurchase Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product TourismProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([rating])
}

model CancellationPolicy {
  id String @id @default(uuid())

  productId String         @unique
  product   TourismProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  fullRefundHours      Int     @default(48)
  partialRefundHours   Int     @default(24)
  partialRefundPercent Decimal @default(50) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommerceAuditLog {
  id String @id @default(uuid())

  actorId String?
  action  String

  entityType String
  entityId   String

  previousState Json?
  newState      Json?

  createdAt DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([actorId])
  @@index([createdAt])
}

model IdempotencyKey {
  id String @id @default(uuid())

  key       String  @unique
  operation String
  userId    String?

  response Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([operation])
}

// ─────────────────────────────────────────────────────────────────────────────
// GENERIC TOURISM CONTENT TEMPLATE ENGINE (PHASE 2)
// ─────────────────────────────────────────────────────────────────────────────

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EntryStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum AuditAction {
  CREATED
  UPDATED
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
  UNPUBLISHED
  DELETED
}

enum FieldType {
  TEXT
  TEXTAREA
  RICHTEXT
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  IMAGE
  GALLERY
  VIDEO
  AUDIO
  GEO_POINT
  MAP_REGION
  DROPDOWN
  MULTISELECT
  TAGS
  RELATION
}

model ContentTemplate {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  description      String?
  icon             String?
  status           TemplateStatus @default(DRAFT)
  version          Int            @default(1)
  publishedVersion Int?

  fields   TemplateField[]
  entries  ContentEntry[]
  versions TemplateVersion[]

  createdBy    String
  createdById  String?
  updatedById  String?
  createdByRel User?   @relation("ContentTemplateCreatedBy", fields: [createdById], references: [id])
  updatedByRel User?   @relation("ContentTemplateUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdById])
}

model TemplateField {
  id         String          @id @default(cuid())
  templateId String
  template   ContentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  key          String
  label        String
  fieldType    FieldType
  required     Boolean   @default(false)
  order        Int
  options      Json?
  helpText     String?
  translatable Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, key])
  @@index([templateId, order])
}

model TemplateVersion {
  id         String          @id @default(cuid())
  templateId String
  template   ContentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  version      Int
  snapshot     Json
  createdBy    String
  createdById  String?
  publishedAt  DateTime?
  createdByRel User?     @relation("TemplateVersionCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())

  @@unique([templateId, version])
  @@index([templateId])
}

model ContentEntry {
  id String @id @default(cuid())

  templateId String
  template   ContentTemplate @relation(fields: [templateId], references: [id])

  templateVersion Int @default(1)

  slug String
  data Json

  status EntryStatus @default(DRAFT)

  authorId   String
  author     User?   @relation("ContentEntryAuthor", fields: [authorId], references: [id])
  reviewedBy String?
  reviewNote String?

  region   String?
  district String?
  division String?

  latitude  Float?
  longitude Float?

  publishedAt DateTime?

  location Unsupported("geography(Point, 4326)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs ContentAuditLog[]

  searchIndex ContentSearchIndex?

  @@unique([templateId, slug])
  @@index([templateId, status])
  @@index([region, status])
  @@index([district, status])
  @@index([latitude, longitude])
}

model ContentAuditLog {
  id String @id @default(cuid())

  entryId String
  entry   ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  action  AuditAction
  actorId String

  metadata Json?

  createdAt DateTime @default(now())

  @@index([entryId, createdAt])
}

model ContentSearchIndex {
  id String @id @default(cuid())

  entryId String       @unique
  entry   ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  templateId String

  title          String?
  searchableText String

  region   String?
  division String?
  district String?

  lat Float?
  lng Float?

  tags Json?

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([region])
  @@index([division])
  @@index([district])
  @@index([publishedAt])
  @@index([lat, lng])
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 4: TRIP PLANNING & ITINERARY DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

enum TripStatus {
  DRAFT
  PLANNING
  READY
  ARCHIVED
}

enum TripPace {
  RELAXED
  BALANCED
  FAST
}

enum ItineraryStatus {
  DRAFT
  READY
  ARCHIVED
}

enum ItineraryGenerator {
  MANUAL
  RULE_ENGINE
  AI_ASSISTED
}

model Trip {
  id              String          @id @default(cuid())
  userId          String?
  title           String
  startDate       DateTime
  endDate         DateTime
  originLatitude  Decimal?        @db.Decimal(10, 7)
  originLongitude Decimal?        @db.Decimal(10, 7)
  travelers       Int             @default(1)
  status          TripStatus      @default(DRAFT)

  itineraries     Itinerary[]
  preferences     TripPreference?
  constraints     TripConstraint?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([startDate, endDate])
}

model TripPreference {
  id             String   @id @default(cuid())
  tripId         String   @unique

  categories     Json?
  pace           TripPace @default(BALANCED)
  accessibility  Boolean  @default(false)
  preferredStart String?
  preferredEnd   String?

  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripConstraint {
  id                 String   @id @default(cuid())
  tripId             String   @unique

  maxDailyDistanceKm Decimal? @db.Decimal(10, 2)
  maxDailyTravelMin  Int?
  budgetAmount       Decimal? @db.Decimal(12, 2)
  requiredPlaceIds   Json?
  excludedPlaceIds   Json?

  trip               Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Itinerary {
  id               String             @id @default(cuid())
  tripId           String
  version          Int                @default(1)
  status           ItineraryStatus    @default(DRAFT)
  generatedBy      ItineraryGenerator @default(MANUAL)

  totalDistanceKm  Decimal?           @db.Decimal(12, 2)
  totalDurationMin Int?
  estimatedCost    Decimal?           @db.Decimal(12, 2)

  trip             Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  days             ItineraryDay[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([tripId])
  @@index([status])
}

model ItineraryDay {
  id          String          @id @default(cuid())
  itineraryId String
  date        DateTime
  sequence    Int
  startTime   String?
  endTime     String?

  itinerary   Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  stops       ItineraryStop[]

  @@unique([itineraryId, sequence])
  @@unique([itineraryId, date])
}

model ItineraryStop {
  id                    String       @id @default(cuid())
  dayId                 String
  placeId               String
  experienceId          String?
  sequence              Int

  arrivalTime           String?
  departureTime         String?
  travelFromPreviousMin Int?
  visitDurationMin      Int?
  estimatedCost         Decimal?     @db.Decimal(12, 2)
  reason                String?
  isLocked              Boolean      @default(false)

  day                   ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  place                 Place        @relation(fields: [placeId], references: [id], onDelete: Restrict)
  experience            Experience?  @relation(fields: [experienceId], references: [id], onDelete: SetNull)

  @@unique([dayId, sequence])
  @@index([placeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 5: COMMUNITY, CREATOR, COMMERCE, BOOKINGS, REVIEWS & SAFETY DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

enum CreatorStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  FLAGGED
  REMOVED
}

enum BookingLifecycleStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum EmergencySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  TRIGGERED
  ACKNOWLEDGED
  DISPATCHED
  RESPONDING
  ON_SCENE
  RESOLVED
  ESCALATED
}

model CreatorContent {
  id               String         @id @default(cuid())
  creatorId        String
  type             String         @default("STORY") // VIDEO, PHOTO, STORY, GUIDE, FOLKLORE, EXPERIENCE
  title            String
  description      String?
  mediaUrl         String?
  location         String?
  placeId          String?
  language         String         @default("en")
  status           String         @default("DRAFT") // DRAFT, SUBMITTED, MODERATION, PUBLISHED, ARCHIVED
  moderationStatus String         @default("PENDING") // PENDING, APPROVED, REJECTED
  moderationReason String?
  moderatedBy      String?
  moderatedAt      DateTime?
  publishedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  creator          CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  place            Place?         @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([creatorId])
  @@index([status])
  @@index([moderationStatus])
  @@index([placeId])
}

model EmergencyIncident {
  id                 String            @id @default(cuid())
  incidentNumber     String            @unique
  userId             String?
  tripId             String?
  latitude           Float
  longitude          Float
  type               String            @default("MEDICAL") // MEDICAL, ACCIDENT, LOST, FIRE, WILDLIFE, WEATHER, CRIME, VEHICLE, OTHER
  severity           EmergencySeverity @default(HIGH)
  status             IncidentStatus    @default(TRIGGERED)
  description        String?
  primaryResponder   String?
  primaryResponderId String?
  createdAt          DateTime          @default(now())
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        String    @default("PENDING") // PENDING, PROCESSED, DEAD_LETTER
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now())
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model PaymentWebhookEvent {
  id          String    @id @default(uuid())
  provider    String    // e.g. "RAZORPAY", "STRIPE", "MOCK"
  eventId     String
  bookingId   String?
  payload     Json?
  status      String    @default("PROCESSED")
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  booking     Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([bookingId])
  @@index([receivedAt])
}


