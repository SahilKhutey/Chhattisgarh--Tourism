# ==============================================================================
# CG Tourism Platform - Environment Variables Template
# ==============================================================================
# WARNING: NEVER COMMIT ACTUAL SECRETS TO SOURCE CONTROL.
# Copy this file to `.env` and fill in the secure values before deploying.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_DB=cgtourism

# Prisma Connection URL (Must match the credentials above)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="postgresql://postgres:your_secure_database_password_here@postgres:5432/cgtourism"

# ------------------------------------------------------------------------------
# 2. CACHE CONFIGURATION (Redis)
# ------------------------------------------------------------------------------
REDIS_URL="redis://redis:6379"

# ------------------------------------------------------------------------------
# 3. BACKEND API CONFIGURATION (NestJS)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend domains
CORS_ALLOWED_ORIGINS="https://cgtourism.com,https://www.cgtourism.com"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Generate a secure 256-bit secret key (e.g., using `openssl rand -hex 32`)
JWT_SECRET="generate_a_secure_random_string_here"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (Next.js)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL="https://api.cgtourism.com/api/v1"
