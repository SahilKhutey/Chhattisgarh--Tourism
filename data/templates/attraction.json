{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Attraction",
  "slug": "attraction",
  "category": "attractions",
  "description": "Monuments, archaeological sites, wildlife sanctuaries, and scenic viewpoints",
  "icon": "sparkles",
  "version": "1.0.0",
  "fields": [
    {
      "key": "name",
      "label": "Attraction Name",
      "type": "text",
      "order": 1,
      "required": true,
      "translatable": true,
      "validation": { "min_length": 2, "max_length": 150 }
    },
    {
      "key": "description",
      "label": "Attraction Details",
      "type": "rich_text",
      "order": 2,
      "required": true,
      "translatable": true
    },
    {
      "key": "district",
      "label": "District",
      "type": "text",
      "order": 3,
      "required": true,
      "translatable": false
    },
    {
      "key": "category",
      "label": "Attraction Category",
      "type": "text",
      "order": 4,
      "required": false,
      "translatable": false
    },
    {
      "key": "tags",
      "label": "Tags",
      "type": "tags",
      "order": 5,
      "required": false,
      "translatable": false
    }
  ]
}
